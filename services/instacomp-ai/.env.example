INSTACOMP_AI_CODENAME="InstaComp AI 1.0 Beta"
INSTACOMP_AI_VERSION="1.0.0-beta.registry-pipeline"
INSTACOMP_AI_HOST=127.0.0.1
INSTACOMP_AI_PORT=8787

# Local evidence and learning data. Relative paths remain inside the protected service folder.
INSTACOMP_AI_DATABASE_PATH=./data/instacomp_ai.sqlite3
INSTACOMP_AI_IMAGE_STORE_PATH=./data/images

# Optional non-authoritative local checklist cache source.
# Canonical identity always comes from INSTACOMP_AI_REGISTRY_URL.
INSTACOMP_AI_LOCAL_CACHE_SOURCE_PATH=

# Local backup configuration.
INSTACOMP_AI_BACKUP_DEFAULT_DESTINATION=./backups
INSTACOMP_AI_BACKUP_ALLOWED_ROOTS=

INSTACOMP_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
INSTACOMP_AI_OLLAMA_MODEL=qwen2.5vl:7b
INSTACOMP_AI_OLLAMA_TIMEOUT_SECONDS=120

# Authenticated central Checklist Registry. Never commit the token.
INSTACOMP_AI_REGISTRY_URL=
INSTACOMP_AI_REGISTRY_TOKEN=

# Required before intentionally binding the local service beyond localhost.
INSTACOMP_AI_API_KEY=
