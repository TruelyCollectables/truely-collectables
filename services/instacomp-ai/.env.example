INSTACOMP_AI_CODENAME="InstaComp AI 1.0 Beta"
INSTACOMP_AI_VERSION="1.0.0-beta.registry-pipeline"
INSTACOMP_AI_HOST=127.0.0.1
INSTACOMP_AI_PORT=8787

# Local evidence and learning data. Relative paths remain inside the protected service folder.
INSTACOMP_AI_DATABASE_PATH=./data/instacomp_ai.sqlite3
INSTACOMP_AI_IMAGE_STORE_PATH=./data/images

# Optional non-authoritative local checklist cache source.
# Canonical identity always comes from INSTACOMP_AI_REGISTRY_URL.
INSTACOMP_AI_LOCAL_CACHE_SOURCE_PATH=

# Local backup configuration.
INSTACOMP_AI_BACKUP_DEFAULT_DESTINATION=./backups
INSTACOMP_AI_BACKUP_ALLOWED_ROOTS=

INSTACOMP_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
INSTACOMP_AI_OLLAMA_MODEL=qwen2.5vl:7b
INSTACOMP_AI_OLLAMA_TIMEOUT_SECONDS=120

# Authenticated central Checklist Registry used by the normal card-identity path.
# The Sentinel installer does not read, replace, or rotate this credential.
INSTACOMP_AI_REGISTRY_URL=https://truelycollectables.com
INSTACOMP_AI_REGISTRY_TOKEN=

# The Mac service remains localhost-only. Vercel reaches it through the named
# Cloudflare tunnel and sends the same secret from INSTACOMP_AI_LOCAL_KEY.
INSTACOMP_AI_API_KEY=

# InstaComp AI Checklist Sentinel™ owns this schedule inside the Mac service.
INSTACOMP_AI_SENTINEL_ENABLED=true
INSTACOMP_AI_SENTINEL_INTERVAL_SECONDS=86400
INSTACOMP_AI_SENTINEL_POLL_SECONDS=60
INSTACOMP_AI_SENTINEL_CHECKPOINT_SECONDS=300
INSTACOMP_AI_SENTINEL_STALE_SECONDS=720
INSTACOMP_AI_SENTINEL_MAX_TARGETS_PER_RUN=75
INSTACOMP_AI_SENTINEL_MAX_CANDIDATES_PER_TARGET=20
INSTACOMP_AI_SENTINEL_REQUEST_TIMEOUT_SECONDS=45
INSTACOMP_AI_SENTINEL_MAX_DOWNLOAD_BYTES=50000000

# Dedicated credential used only for Sentinel source archival. The installer
# generates it locally and stores the matching Vercel value as a sensitive env.
INSTACOMP_AI_SENTINEL_ARCHIVE_TOKEN=

# Keep the large multipart transfer on localhost using HTTP Basic authentication.
# The relay verifies those bytes, then Production independently fetches the public
# source, checks the same SHA-256, and archives it in private Supabase Storage.
# The installer writes the authenticated localhost URL; do not hand-edit it.
INSTACOMP_AI_SENTINEL_IMPORT_URL=
INSTACOMP_AI_SENTINEL_CENTRAL_IMPORT_URL=https://truelycollectables.com/api/instacomp/checklist-sentinel/import

# Optional central feed. Local exact targets and broad vintage discovery work
# without this value; configure only after an authenticated Registry gap feed exists.
INSTACOMP_AI_SENTINEL_TARGETS_URL=
