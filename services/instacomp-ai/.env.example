INSTACOMP_AI_CODENAME="InstaComp AI 1.0 Beta"
INSTACOMP_AI_VERSION="1.0.0-beta.prechecklist"
INSTACOMP_AI_HOST=127.0.0.1
INSTACOMP_AI_PORT=8787

# All relative paths stay inside the protected services/instacomp-ai folder.
INSTACOMP_AI_DATABASE_PATH=./data/instacomp_ai.sqlite3
INSTACOMP_AI_IMAGE_STORE_PATH=./data/images
INSTACOMP_AI_CHECKLIST_MIRROR_PATH=./data/checklists/mirror
INSTACOMP_AI_REGISTRY_PATH=./data/registry/checklist-registry.sqlite3
INSTACOMP_AI_BACKUP_DEFAULT_DESTINATION=./backups

# Exact Google Drive for Desktop folder containing the approved checklist collection.
# Example:
# /Users/YOU/Library/CloudStorage/GoogleDrive-YOU/My Drive/TCOS Checklist Registry - 2025-26 Hockey Consolidated
INSTACOMP_AI_CHECKLIST_SOURCE_PATH=

# Comma-separated folders that the Backup Vault is permitted to write into.
# Leave blank to permit only INSTACOMP_AI_BACKUP_DEFAULT_DESTINATION.
INSTACOMP_AI_BACKUP_ALLOWED_ROOTS=

INSTACOMP_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
INSTACOMP_AI_OLLAMA_MODEL=qwen2.5vl:7b
INSTACOMP_AI_OLLAMA_TIMEOUT_SECONDS=120
INSTACOMP_AI_ALLOW_TEACHER_SUGGESTIONS=true
INSTACOMP_AI_REQUIRE_OPERATOR_FOR_TRUSTED_MEMORY=true

# Set a long random value before exposing the service beyond localhost.
INSTACOMP_AI_API_KEY=
