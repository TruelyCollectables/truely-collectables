{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truely-collectables-preview",
  "main": "./cloudflare-worker.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "truelycollectables.com",
      "custom_domain": true
    },
    {
      "pattern": "www.truelycollectables.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "truely-collectables-preview"
    }
  ],
  "observability": {
    "enabled": true
  }
}
