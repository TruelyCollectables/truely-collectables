{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truely-collectables",
  "main": "./cloudflare-storefront-entrypoint.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "truely-collectables"
    }
  ],
  "routes": [
    {
      "pattern": "truelycollectables.com/*",
      "zone_name": "truelycollectables.com"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
